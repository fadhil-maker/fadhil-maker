<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 200" fill="none">
  <style>
    /* ===== Fonts ===== */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap');

    /* ===== Card fade-in ===== */
    @keyframes cardFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .card { animation: cardFadeIn 0.6s ease both; }

    /* ===== Title shimmer ===== */
    @keyframes titleGlow {
      0%, 100% { opacity: 0.85; }
      50%      { opacity: 1; }
    }
    .title { animation: titleGlow 3s ease-in-out infinite; }

    /* ===== Rank ring draw ===== */
    @keyframes drawRing {
      from { stroke-dashoffset: 220; }
      to   { stroke-dashoffset: 55; }
    }
    .rank-ring {
      stroke-dasharray: 220;
      stroke-dashoffset: 220;
      animation: drawRing 1.5s cubic-bezier(0.4, 0, 0.2, 1) 0.4s both;
      transform-origin: center;
    }

    /* ===== Rank ring glow pulse ===== */
    @keyframes ringPulse {
      0%, 100% { filter: drop-shadow(0 0 3px rgba(245,158,11,0.3)); }
      50%      { filter: drop-shadow(0 0 8px rgba(245,158,11,0.6)); }
    }
    .rank-ring-group {
      animation: ringPulse 3s ease-in-out 2s infinite;
    }

    /* ===== Rank letter pop ===== */
    @keyframes rankPop {
      0%   { opacity: 0; transform: scale(0.3); }
      70%  { transform: scale(1.1); }
      100% { opacity: 1; transform: scale(1); }
    }
    .rank-letter {
      opacity: 0;
      animation: rankPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.6s both;
    }

    /* ===== Stat rows slide in ===== */
    @keyframes slideIn {
      from { opacity: 0; transform: translateX(30px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    .stat-row { opacity: 0; }
    .stat-row-1 { animation: slideIn 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.5s both; }
    .stat-row-2 { animation: slideIn 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.65s both; }
    .stat-row-3 { animation: slideIn 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.8s both; }
    .stat-row-4 { animation: slideIn 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.95s both; }
    .stat-row-5 { animation: slideIn 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) 1.1s both; }

    /* ===== Value count-up highlight ===== */
    @keyframes valueHighlight {
      0%   { fill: #f59e0b; }
      100% { fill: #f0eef6; }
    }
    .stat-val-1 { animation: valueHighlight 0.8s ease 0.95s both; }
    .stat-val-2 { animation: valueHighlight 0.8s ease 1.1s both; }
    .stat-val-3 { animation: valueHighlight 0.8s ease 1.25s both; }
    .stat-val-4 { animation: valueHighlight 0.8s ease 1.4s both; }
    .stat-val-5 { animation: valueHighlight 0.8s ease 1.55s both; }

    /* ===== Shared text styles ===== */
    text { font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif; }
  </style>

  <defs>
    <!-- Card background gradient -->
    <linearGradient id="cardBg" x1="0" y1="0" x2="500" y2="200" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#12102e"/>
      <stop offset="100%" stop-color="#0d0b20"/>
    </linearGradient>
    <!-- Amber gradient for ring -->
    <linearGradient id="amberGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f59e0b"/>
      <stop offset="50%" stop-color="#fbbf24"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
    <!-- Subtle inner glow -->
    <radialGradient id="innerGlow" cx="0.15" cy="0.15" r="0.85">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.06"/>
      <stop offset="100%" stop-color="transparent" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- === Card body === -->
  <g class="card">
    <!-- Background -->
    <rect x="0.5" y="0.5" width="499" height="199" rx="12" ry="12"
          fill="url(#cardBg)" stroke="#7c3aed" stroke-opacity="0.3" stroke-width="1"/>
    <!-- Inner glow overlay -->
    <rect x="1" y="1" width="498" height="198" rx="12" ry="12" fill="url(#innerGlow)"/>

    <!-- === Title === -->
    <text class="title" x="25" y="32" fill="#f59e0b" font-size="15" font-weight="700"
          letter-spacing="0.3">Fadhil's GitHub Stats</text>

    <!-- ============ RANK RING (left side) ============ -->
    <g class="rank-ring-group" transform="translate(80, 118)">
      <!-- Background track circle -->
      <circle cx="0" cy="0" r="35" fill="none" stroke="#7c3aed" stroke-opacity="0.15"
              stroke-width="5"/>
      <!-- Animated ring -->
      <circle class="rank-ring" cx="0" cy="0" r="35" fill="none"
              stroke="url(#amberGrad)" stroke-width="5" stroke-linecap="round"
              transform="rotate(-90)"/>
      <!-- Rank letter -->
      <text class="rank-letter" x="0" y="2" text-anchor="middle" dominant-baseline="central"
            fill="#f59e0b" font-size="22" font-weight="700">B+</text>
    </g>

    <!-- ============ STAT ROWS (right side) ============ -->
    <!-- Row 1: Stars -->
    <g class="stat-row stat-row-1" transform="translate(155, 56)">
      <text x="0" y="0" font-size="13">⭐</text>
      <text x="22" y="0" fill="#8b8ba7" font-size="12.5" font-weight="400">Total Stars:</text>
      <text class="stat-val-1" x="310" y="0" fill="#f0eef6" font-size="13" font-weight="700"
            text-anchor="end">5</text>
    </g>
    <!-- Row 2: Commits -->
    <g class="stat-row stat-row-2" transform="translate(155, 82)">
      <text x="0" y="0" font-size="13">🔥</text>
      <text x="22" y="0" fill="#8b8ba7" font-size="12.5" font-weight="400">Total Commits:</text>
      <text class="stat-val-2" x="310" y="0" fill="#f0eef6" font-size="13" font-weight="700"
            text-anchor="end">120+</text>
    </g>
    <!-- Row 3: PRs -->
    <g class="stat-row stat-row-3" transform="translate(155, 108)">
      <text x="0" y="0" font-size="13">🔀</text>
      <text x="22" y="0" fill="#8b8ba7" font-size="12.5" font-weight="400">Pull Requests:</text>
      <text class="stat-val-3" x="310" y="0" fill="#f0eef6" font-size="13" font-weight="700"
            text-anchor="end">8</text>
    </g>
    <!-- Row 4: Issues -->
    <g class="stat-row stat-row-4" transform="translate(155, 134)">
      <text x="0" y="0" font-size="13">📋</text>
      <text x="22" y="0" fill="#8b8ba7" font-size="12.5" font-weight="400">Issues:</text>
      <text class="stat-val-4" x="310" y="0" fill="#f0eef6" font-size="13" font-weight="700"
            text-anchor="end">12</text>
    </g>
    <!-- Row 5: Contributed to -->
    <g class="stat-row stat-row-5" transform="translate(155, 160)">
      <text x="0" y="0" font-size="13">🏗️</text>
      <text x="22" y="0" fill="#8b8ba7" font-size="12.5" font-weight="400">Contributed to:</text>
      <text class="stat-val-5" x="310" y="0" fill="#f0eef6" font-size="13" font-weight="700"
            text-anchor="end">4</text>
    </g>

    <!-- Subtle bottom separator line -->
    <line x1="25" y1="180" x2="475" y2="180" stroke="#7c3aed" stroke-opacity="0.1" stroke-width="0.5"/>
    <text x="25" y="193" fill="#8b8ba7" font-size="9" font-weight="400" opacity="0.6">@fadhil-maker</text>
  </g>
</svg>
